// ================================================================
//  PRISMA SCHEMA - Hệ thống Quản lý Phòng Khám
//  Provider: MySQL (TiDB)
// ================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================================================================
//  ENUMS
// ================================================================

enum Role {
  PATIENT
  DOCTOR
  RECEPTIONIST
  ADMIN
}

// ================================================================
//  MODELS
// ================================================================

// ── 1. Users ─────────────────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(100)
  email        String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(PATIENT)

  // Thông tin cá nhân
  patientCode  String?  @default("BN-NEW")
  phone        String?  @db.VarChar(20)
  dob          String?  @db.VarChar(20)
  gender       String?  @default("Nam")
  address      String?  @db.VarChar(255)
  avatar       String?  @db.Text
  cccd         String?  @db.VarChar(20)
  bhyt         String?  @db.VarChar(30)
  insurance    String?  @db.VarChar(100)
  status       String   @default("Hoạt động") // Hoạt động | Chờ xác minh | Khóa tài khoản | Đang điều trị

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  doctorProfile         DoctorProfile?
  healthMetric          HealthMetric?
  appointmentsAsPatient Appointment[]  @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[]  @relation("DoctorAppointments")
  examinationsAsPatient Examination[]  @relation("PatientExaminations")
  examinationsAsDoctor  Examination[]  @relation("DoctorExaminations")
  prescriptions         Prescription[] @relation("PatientPrescriptions")
  prescriptionsAsDoctor Prescription[] @relation("DoctorPrescriptions")
  labTests              LabTest[]

  @@map("users")
}

// ── 2. DoctorProfile ─────────────────────────────────────────────
model DoctorProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  user        User    @relation(fields: [userId], references: [id])

  // Thông tin chung
  specialty   String
  experience  String
  status      String  @default("Đang làm việc") // Đang làm việc | Nghỉ phép | Nghỉ hưu
  rating      Float   @default(5.0)
  price       Int     @default(150000)
  imagePrefix String  @default("D")

  // Thông tin chuyên môn
  degree       String? @default("Thạc sĩ Y Khoa")
  university   String? @default("Đại học Y Hà Nội")
  languages    String? @default("Việt, Anh")
  certificates Json?
  schedule     Json?
}

// ── 3. HealthMetric ──────────────────────────────────────────────
model HealthMetric {
  id             Int      @id @default(autoincrement())
  patientId      Int      @unique
  patient        User     @relation(fields: [patientId], references: [id])

  // Chỉ số sinh tồn
  heartRate      Int?     @default(75)
  bloodPressure  String?  @default("120/80")
  temperature    Float?   @default(36.8)
  weight         Float?   @default(65)
  height         Float?   @default(170)
  respiratoryRate Int?    @default(18)
  spO2           Int?     @default(98)
  bmi            Float?   @default(22.5)

  // Thông tin sức khỏe
  bloodType      String   @default("Chưa xác định")
  allergies      String   @default("Không có")
  healthStatus   String   @default("Bình thường")
  medicalHistory String?  @db.Text

  // Đánh giá AI
  aiScore        Int      @default(90)
  aiMessage      String   @default("Sức khỏe ổn định.")

  updatedAt      DateTime @updatedAt
}

// ── 4. Appointment ───────────────────────────────────────────────
model Appointment {
  id              Int      @id @default(autoincrement())
  patientId       Int
  patient         User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId        Int
  doctor          User     @relation("DoctorAppointments", fields: [doctorId], references: [id])

  appointmentCode String?  @unique
  queueNumber     String?
  specialty       String
  bookingDate     String
  bookingTime     String
  room            String?
  reason          String?  @db.Text
  status          String   @default("CHỜ XÁC NHẬN") // CHỜ XÁC NHẬN | ĐÃ XÁC NHẬN | ĐÃ CẤP SỐ | ĐANG KHÁM | HOÀN THÀNH | ĐÃ HỦY | BỎ LƯỢT

  createdAt       DateTime @default(now())

  // Relations
  examination     Examination?
}

// ── 5. Examination ───────────────────────────────────────────────
model Examination {
  id             Int         @id @default(autoincrement())
  appointmentId  Int         @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  patientId      Int
  patient        User        @relation("PatientExaminations", fields: [patientId], references: [id])
  doctorId       Int
  doctor         User        @relation("DoctorExaminations", fields: [doctorId], references: [id])

  symptoms       String      @db.Text
  medicalHistory String?     @db.Text
  diagnosis      String      @db.Text
  treatment      String?     @db.Text
  notes          String?     @db.Text

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

// ── 6. Prescription ──────────────────────────────────────────────
model Prescription {
  id           Int      @id @default(autoincrement())
  patientId    Int
  patient      User     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  doctorId     Int?
  doctor       User?    @relation("DoctorPrescriptions", fields: [doctorId], references: [id])

  code         String
  diagnosis    String?
  symptoms     String?  @db.Text
  treatment    String?  @db.Text
  notes        String?  @db.Text
  type         String?  @default("Ngoại trú") // Ngoại trú | Nội trú
  followUpDate String?
  status       String   @default("Chờ phát")  // Chờ phát | Đã phát | Đã hủy

  createdAt    DateTime @default(now())

  // Relations
  items        PrescriptionItem[]
}

// ── 7. PrescriptionItem ──────────────────────────────────────────
model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])

  medicationName String
  dosage         String
  instructions   String
  remaining      String
  statusText     String
  iconType       String       // pill | liquid
}

// ── 8. LabTest ───────────────────────────────────────────────────
model LabTest {
  id         Int      @id @default(autoincrement())
  patientId  Int
  patient    User     @relation(fields: [patientId], references: [id])

  testName   String
  date       DateTime
  doctorName String
  result     String
  statusType String   // GOOD | WARNING | DANGER
  notes      String?  @db.Text
}

// ── 9. SystemSetting ─────────────────────────────────────────────
model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)

  updatedAt   DateTime @updatedAt @map("updated_at")
}

// ── 10. SystemLog ────────────────────────────────────────────────
model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String   @db.VarChar(255)
  user      String   @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
}